{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/iteathen/CUDA-MCGS/schemas/search-ir/0.2.0/execution-package.schema.json",
  "title": "CUDA-MCGS accepted execution package and CUDA-JS adapter requirements",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "semantic",
    "program",
    "cudaJsAdapter",
    "manifests",
    "compatibility",
    "provenance",
    "deletion"
  ],
  "properties": {
    "schema": {
      "const": "cuda-mcgs.execution-package/0.2.0"
    },
    "status": {
      "const": "accepted"
    },
    "semantic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engineIdentity",
        "selectedProfiles",
        "entryPointRoles",
        "resourcePlan",
        "progressPlan",
        "outputProfile",
        "sessionProfile",
        "stageProfile",
        "channelProfile"
      ],
      "properties": {
        "engineIdentity": {
          "$ref": "primitives.schema.json#/$defs/contentIdentity"
        },
        "selectedProfiles": {
          "type": "array",
          "minItems": 6,
          "items": {
            "$ref": "program-package-profile.schema.json#/$defs/profileReference"
          }
        },
        "entryPointRoles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "function"
            ],
            "properties": {
              "role": {
                "$ref": "primitives.schema.json#/$defs/namespacedId"
              },
              "function": {
                "type": "string"
              }
            }
          }
        },
        "resourcePlan": {
          "$ref": "program-package-profile.schema.json#/$defs/profileReference"
        },
        "progressPlan": {
          "$ref": "program-package-profile.schema.json#/$defs/profileReference"
        },
        "outputProfile": {
          "$ref": "program-package-profile.schema.json#/$defs/profileReference"
        },
        "sessionProfile": {
          "$ref": "program-package-profile.schema.json#/$defs/optionalProfileReference"
        },
        "stageProfile": {
          "$ref": "program-package-profile.schema.json#/$defs/optionalProfileReference"
        },
        "channelProfile": {
          "$ref": "program-package-profile.schema.json#/$defs/optionalProfileReference"
        }
      }
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "identity",
        "sourceIdentity",
        "functions"
      ],
      "properties": {
        "schema": {
          "const": "cuda-mcgs.search-program/0.2.0"
        },
        "identity": {
          "$ref": "primitives.schema.json#/$defs/contentIdentity"
        },
        "sourceIdentity": {
          "$ref": "primitives.schema.json#/$defs/contentIdentity"
        },
        "functions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/publicFunction"
          }
        }
      }
    },
    "manifests": {
      "$ref": "program-package-profile.schema.json#/$defs/manifests"
    },
    "compatibility": {
      "$ref": "program-package-profile.schema.json#/$defs/compatibility"
    },
    "provenance": {
      "$ref": "program-package-profile.schema.json#/$defs/provenance"
    },
    "deletion": {
      "$ref": "program-package-profile.schema.json#/$defs/deletion"
    },
    "cudaJsAdapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "publicContracts",
        "searchProgram",
        "resourceRequirements",
        "operationRequirements",
        "searchLifecycle"
      ],
      "description": "MCGS-owned input to integration.cuda-js. Actual CUDA-JS request objects, field names, allowed variants, finite lower limits and lower resource lifecycle are validated/constructed by the adapter from the selected public CUDA-JS package.",
      "properties": {
        "schema": {
          "const": "cuda-mcgs.cuda-js-adapter-requirements/0.2.0"
        },
        "publicContracts": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "primitives.schema.json#/$defs/schemaReference"
          }
        },
        "searchProgram": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "functions"
          ],
          "properties": {
            "source": {
              "type": "string",
              "minLength": 1
            },
            "functions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/publicFunction"
              }
            }
          }
        },
        "resourceRequirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resourceRequirement"
          }
        },
        "operationRequirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/operationRequirement"
          }
        },
        "searchLifecycle": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ignition",
            "cancellation",
            "completion"
          ],
          "properties": {
            "ignition": {
              "const": "device-owned"
            },
            "cancellation": {
              "const": "bounded-external-intent"
            },
            "completion": {
              "const": "device-owned-closure"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "publicFunction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "executionRole",
        "parameters",
        "returns"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "program-package-profile.schema.json#/$defs/parameter"
          }
        },
        "returns": {
          "enum": [
            "void",
            "bool",
            "u32",
            "i32",
            "u64",
            "f32"
          ]
        },
        "executionRole": {
          "enum": [
            "runtime-entry",
            "device-callable"
          ]
        }
      }
    },
    "publicBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parameter",
        "source"
      ],
      "properties": {
        "parameter": {
          "type": "string",
          "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
        },
        "source": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "resource"
              ],
              "properties": {
                "kind": {
                  "const": "resource"
                },
                "resource": {
                  "type": "string",
                  "pattern": "^resource-[0-9]+$"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "schema"
              ],
              "properties": {
                "kind": {
                  "const": "scalar"
                },
                "schema": {
                  "$ref": "primitives.schema.json#/$defs/schemaReference"
                }
              }
            }
          ]
        }
      }
    },
    "resourceRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "byteLength",
        "alignment",
        "memorySpaces",
        "accessRequirements"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^resource-[0-9]+$"
        },
        "byteLength": {
          "$ref": "primitives.schema.json#/$defs/decimalUint"
        },
        "alignment": {
          "$ref": "primitives.schema.json#/$defs/decimalUint"
        },
        "memorySpaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "host-admission",
              "device-search",
              "device-publication",
              "durable"
            ]
          }
        },
        "accessRequirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "read",
              "write",
              "atomic",
              "publish"
            ]
          }
        }
      }
    },
    "operationRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "function",
        "bindings",
        "launchPolicy"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^operation-[0-9]+$"
        },
        "function": {
          "type": "string",
          "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
        },
        "bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/publicBinding"
          }
        },
        "launchPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "grid",
            "block",
            "dynamicSharedBytes",
            "maxPending"
          ],
          "properties": {
            "grid": {
              "$ref": "program-package-profile.schema.json#/$defs/dim3"
            },
            "block": {
              "$ref": "program-package-profile.schema.json#/$defs/dim3"
            },
            "dynamicSharedBytes": {
              "$ref": "primitives.schema.json#/$defs/decimalUint"
            },
            "maxPending": {
              "$ref": "primitives.schema.json#/$defs/decimalUint"
            }
          }
        }
      }
    }
  }
}
