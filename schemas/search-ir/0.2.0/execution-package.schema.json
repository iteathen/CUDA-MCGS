{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/iteathen/CUDA-MCGS/schemas/search-ir/0.2.0/execution-package.schema.json",
  "title": "CUDA-MCGS accepted execution package and CUDA-JS adapter requirements",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "semantic",
    "program",
    "cudaJsAdapter",
    "manifests",
    "compatibility",
    "provenance",
    "deletion"
  ],
  "properties": {
    "schema": {
      "const": "cuda-mcgs.execution-package/0.2.0"
    },
    "status": {
      "const": "accepted"
    },
    "semantic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engineIdentity",
        "selectedProfiles",
        "entryPointRoles",
        "resourcePlan",
        "progressPlan",
        "outputProfile",
        "sessionProfile",
        "stageProfile",
        "channelProfile"
      ],
      "properties": {
        "engineIdentity": {
          "$ref": "primitives.schema.json#/$defs/contentIdentity"
        },
        "selectedProfiles": {
          "type": "array",
          "minItems": 6,
          "items": {
            "$ref": "program-package-profile.schema.json#/$defs/profileReference"
          }
        },
        "entryPointRoles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "function"
            ],
            "properties": {
              "role": {
                "$ref": "primitives.schema.json#/$defs/namespacedId"
              },
              "function": {
                "type": "string"
              }
            }
          }
        },
        "resourcePlan": {
          "$ref": "program-package-profile.schema.json#/$defs/profileReference"
        },
        "progressPlan": {
          "$ref": "program-package-profile.schema.json#/$defs/profileReference"
        },
        "outputProfile": {
          "$ref": "program-package-profile.schema.json#/$defs/profileReference"
        },
        "sessionProfile": {
          "$ref": "program-package-profile.schema.json#/$defs/optionalProfileReference"
        },
        "stageProfile": {
          "$ref": "program-package-profile.schema.json#/$defs/optionalProfileReference"
        },
        "channelProfile": {
          "$ref": "program-package-profile.schema.json#/$defs/optionalProfileReference"
        }
      }
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "identity",
        "sourceIdentity",
        "functions"
      ],
      "properties": {
        "schema": {
          "const": "cuda-mcgs.search-program/0.2.0"
        },
        "identity": {
          "$ref": "primitives.schema.json#/$defs/contentIdentity"
        },
        "sourceIdentity": {
          "$ref": "primitives.schema.json#/$defs/contentIdentity"
        },
        "functions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/publicFunction"
          }
        }
      }
    },
    "manifests": {
      "$ref": "program-package-profile.schema.json#/$defs/manifests"
    },
    "compatibility": {
      "$ref": "program-package-profile.schema.json#/$defs/compatibility"
    },
    "provenance": {
      "$ref": "program-package-profile.schema.json#/$defs/provenance"
    },
    "deletion": {
      "$ref": "program-package-profile.schema.json#/$defs/deletion"
    },
    "cudaJsAdapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "publicContracts",
        "searchProgram",
        "resourceRequirements",
        "deliveryRequirements",
        "operationRequirements",
        "searchLifecycle"
      ],
      "description": "MCGS-owned input to integration.cuda-js. Actual CUDA-JS request objects, field names, allowed variants, finite lower limits and lower resource lifecycle are validated/constructed by the adapter from the selected public CUDA-JS package.",
      "properties": {
        "schema": {
          "const": "cuda-mcgs.cuda-js-adapter-requirements/0.2.0"
        },
        "publicContracts": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "primitives.schema.json#/$defs/schemaReference"
          }
        },
        "searchProgram": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "functions"
          ],
          "properties": {
            "source": {
              "type": "string",
              "minLength": 1
            },
            "functions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/publicFunction"
              }
            },
            "deviceImports": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "$ref": "device-js-import-declaration.schema.json"
              }
            }
          }
        },
        "resourceRequirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resourceRequirement"
          }
        },
        "operationRequirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/operationRequirement"
          }
        },
        "searchLifecycle": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ignition",
            "cancellation",
            "completion"
          ],
          "properties": {
            "ignition": {
              "const": "device-owned"
            },
            "cancellation": {
              "const": "bounded-external-intent"
            },
            "completion": {
              "const": "device-owned-closure"
            }
          }
        },
        "sidebandRequirements": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/sidebandRequirement"
          }
        },
        "deliveryRequirements": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/deliveryRequirement"
          }
        },
        "continuation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contract",
            "nodes",
            "controllerOperation"
          ],
          "properties": {
            "contract": {
              "const": "cuda-mcgs.device-continuation/0.1.0"
            },
            "nodes": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "operation",
                  "after"
                ],
                "properties": {
                  "operation": {
                    "type": "string",
                    "minLength": 1
                  },
                  "after": {
                    "type": "array",
                    "maxItems": 8,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            },
            "controllerOperation": {
              "type": "string",
              "minLength": 1
            },
            "externalOperations": {
              "type": "array",
              "maxItems": 16,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "operation",
                  "role"
                ],
                "properties": {
                  "operation": {
                    "type": "string",
                    "minLength": 1
                  },
                  "role": {
                    "enum": [
                      "external-control",
                      "read-only-observation"
                    ]
                  },
                  "delivery": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "resource",
                      "view"
                    ],
                    "properties": {
                      "resource": {
                        "type": "string",
                        "minLength": 1
                      },
                      "view": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "dtype",
                          "byteOffset",
                          "elementCount"
                        ],
                        "properties": {
                          "dtype": {
                            "enum": [
                              "u32",
                              "u64",
                              "i32",
                              "f32",
                              "f64",
                              "f16",
                              "bf16"
                            ]
                          },
                          "byteOffset": {
                            "$ref": "primitives.schema.json#/$defs/decimalUint"
                          },
                          "elementCount": {
                            "$ref": "primitives.schema.json#/$defs/decimalUint"
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "initializationOperations": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "operation",
                  "readiness"
                ],
                "properties": {
                  "operation": {
                    "type": "string",
                    "minLength": 1
                  },
                  "readiness": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "resource",
                      "view",
                      "success"
                    ],
                    "properties": {
                      "resource": {
                        "type": "string",
                        "minLength": 1
                      },
                      "view": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "dtype",
                          "byteOffset",
                          "elementCount"
                        ],
                        "properties": {
                          "dtype": {
                            "const": "u32"
                          },
                          "byteOffset": {
                            "$ref": "primitives.schema.json#/$defs/decimalUint"
                          },
                          "elementCount": {
                            "$ref": "primitives.schema.json#/$defs/decimalUint"
                          }
                        }
                      },
                      "success": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "wordOffset",
                          "value"
                        ],
                        "properties": {
                          "wordOffset": {
                            "$ref": "primitives.schema.json#/$defs/decimalUint"
                          },
                          "value": {
                            "$ref": "primitives.schema.json#/$defs/decimalUint"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "publicRequirementSelections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reference",
              "document"
            ],
            "properties": {
              "reference": {
                "$ref": "primitives.schema.json#/$defs/schemaReference"
              },
              "document": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "schema",
                  "owner",
                  "requirement",
                  "lower"
                ],
                "properties": {
                  "schema": {
                    "const": "cuda-mcgs.public-cuda-js-requirement-selection/0.1.0"
                  },
                  "owner": {
                    "const": "CUDA-MCGS-consumer"
                  },
                  "requirement": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "version",
                      "capability",
                      "value"
                    ],
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "version": {
                        "const": "0.1.0"
                      },
                      "capability": {
                        "type": "string",
                        "minLength": 1
                      },
                      "value": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "lower": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "peer",
                      "compatibility"
                    ],
                    "properties": {
                      "peer": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "repository",
                          "revision",
                          "package"
                        ],
                        "properties": {
                          "repository": {
                            "const": "iteathen/CUDA-JS"
                          },
                          "revision": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{40}$"
                          },
                          "package": {
                            "const": "cuda-js@0.1.0-alpha.22"
                          }
                        }
                      },
                      "compatibility": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "deviceSourcePartition": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contract",
            "libraries",
            "main",
            "imports"
          ],
          "properties": {
            "contract": {
              "const": "cuda-mcgs.device-source-partition/0.1.0"
            },
            "libraries": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "source",
                  "sourceIdentity",
                  "functions",
                  "exports"
                ],
                "properties": {
                  "id": {
                    "$ref": "primitives.schema.json#/$defs/namespacedId"
                  },
                  "source": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sourceIdentity": {
                    "$ref": "primitives.schema.json#/$defs/contentIdentity"
                  },
                  "functions": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 64,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
                    }
                  },
                  "exports": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 64,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
                    }
                  }
                }
              }
            },
            "main": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source",
                "sourceIdentity",
                "functions"
              ],
              "properties": {
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "sourceIdentity": {
                  "$ref": "primitives.schema.json#/$defs/contentIdentity"
                },
                "functions": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 64,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
                  }
                }
              }
            },
            "imports": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "library",
                  "function",
                  "as"
                ],
                "properties": {
                  "library": {
                    "$ref": "primitives.schema.json#/$defs/namespacedId"
                  },
                  "function": {
                    "type": "string",
                    "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
                  },
                  "as": {
                    "type": "string",
                    "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "cudaJsAdapter"
        ],
        "properties": {
          "cudaJsAdapter": {
            "required": [
              "searchProgram"
            ],
            "properties": {
              "searchProgram": {
                "required": [
                  "deviceImports"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "deletion": {
            "properties": {
              "records": {
                "items": {
                  "required": [
                    "deviceImports"
                  ]
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "deletion": {
            "properties": {
              "records": {
                "items": {
                  "not": {
                    "required": [
                      "deviceImports"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "publicFunction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "executionRole",
        "parameters",
        "returns"
      ],
      "properties": {
        "launchConstraint": {
          "$ref": "program-package-profile.schema.json#/$defs/function/properties/launchConstraint"
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "program-package-profile.schema.json#/$defs/parameter"
          }
        },
        "returns": {
          "enum": [
            "void",
            "bool",
            "u32",
            "i32",
            "u64",
            "f32",
            "f64",
            "f16",
            "bf16"
          ]
        },
        "executionRole": {
          "enum": [
            "runtime-entry",
            "device-callable"
          ]
        },
        "executionProfile": {
          "const": "device-continuation-v1"
        },
        "calls": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
          }
        }
      }
    },
    "resourceView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dtype",
        "byteOffset",
        "elementCount"
      ],
      "properties": {
        "dtype": {
          "enum": [
            "u32",
            "u64",
            "i32",
            "f32",
            "f64",
            "f16",
            "bf16"
          ]
        },
        "byteOffset": {
          "$ref": "primitives.schema.json#/$defs/decimalUint"
        },
        "elementCount": {
          "$ref": "primitives.schema.json#/$defs/decimalUint"
        }
      }
    },
    "publicBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parameter",
        "source"
      ],
      "properties": {
        "parameter": {
          "type": "string",
          "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
        },
        "source": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "resource"
              ],
              "properties": {
                "kind": {
                  "const": "resource"
                },
                "resource": {
                  "type": "string",
                  "pattern": "^resource-[0-9]+$"
                },
                "access": {
                  "enum": [
                    "read",
                    "write",
                    "read-write"
                  ],
                  "description": "MCGS-owned operation-local hazard envelope. Atomic/publication meaning requires the explicit deviceEffects proposal; access alone grants no atomic authority."
                },
                "view": {
                  "$ref": "#/$defs/resourceView"
                },
                "deviceEffects": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "enum": [
                      "atomic-add-relaxed-device",
                      "atomic-cas-relaxed-device",
                      "atomic-load-acquire-device",
                      "atomic-store-release-device"
                    ]
                  }
                },
                "initialization": {
                  "const": "zero"
                },
                "initialContentSha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "schema"
              ],
              "properties": {
                "kind": {
                  "const": "scalar"
                },
                "schema": {
                  "$ref": "primitives.schema.json#/$defs/schemaReference"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "sideband"
              ],
              "properties": {
                "kind": {
                  "const": "sideband"
                },
                "sideband": {
                  "type": "string",
                  "pattern": "^sideband-[0-9]+$"
                }
              }
            }
          ]
        }
      }
    },
    "resourceRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "byteLength",
        "alignment",
        "memorySpaces",
        "accessRequirements"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^resource-[0-9]+$"
        },
        "byteLength": {
          "$ref": "primitives.schema.json#/$defs/decimalUint"
        },
        "alignment": {
          "$ref": "primitives.schema.json#/$defs/decimalUint"
        },
        "memorySpaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "host-admission",
              "device-search",
              "device-publication",
              "durable"
            ]
          }
        },
        "accessRequirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "read",
              "write",
              "atomic",
              "publish"
            ]
          }
        }
      }
    },
    "operationRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "function",
        "bindings",
        "launchPolicy"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^operation-[0-9]+$"
        },
        "function": {
          "type": "string",
          "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
        },
        "bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/publicBinding"
          }
        },
        "launchPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "grid",
            "block",
            "dynamicSharedBytes",
            "maxPending"
          ],
          "properties": {
            "grid": {
              "$ref": "program-package-profile.schema.json#/$defs/dim3"
            },
            "block": {
              "$ref": "program-package-profile.schema.json#/$defs/dim3"
            },
            "dynamicSharedBytes": {
              "$ref": "primitives.schema.json#/$defs/decimalUint"
            },
            "maxPending": {
              "$ref": "primitives.schema.json#/$defs/decimalUint"
            }
          }
        },
        "reachableFunctions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
          }
        }
      }
    },
    "sidebandRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "direction",
        "valueType",
        "capacity",
        "publication",
        "applicationPoint",
        "lifetime",
        "residentResource",
        "semantics",
        "cleanup"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^sideband-[0-9]+$"
        },
        "role": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "direction": {
          "enum": [
            "host-to-device",
            "device-to-host"
          ]
        },
        "valueType": {
          "const": "u32"
        },
        "capacity": {
          "$ref": "primitives.schema.json#/$defs/decimalUint"
        },
        "publication": {
          "const": "release-acquire"
        },
        "applicationPoint": {
          "$ref": "primitives.schema.json#/$defs/schemaReference"
        },
        "lifetime": {
          "enum": [
            "operation",
