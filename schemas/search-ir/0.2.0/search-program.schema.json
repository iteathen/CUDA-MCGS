{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/iteathen/CUDA-MCGS/schemas/search-ir/0.2.0/search-program.schema.json",
  "title": "CUDA-MCGS canonical accepted restricted Device-JS Search Program",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "language",
    "semanticEngineIdentity",
    "compositionProfileIdentity",
    "generator",
    "source",
    "sourceIdentity",
    "sourceMap",
    "functions",
    "programUnits",
    "entryPoints",
    "publicRequirements",
    "resources",
    "deliveries",
    "operations",
    "manifests",
    "provenance",
    "deletion"
  ],
  "properties": {
    "schema": {
      "const": "cuda-mcgs.search-program/0.2.0"
    },
    "status": {
      "const": "accepted"
    },
    "language": {
      "const": "restricted-device-js"
    },
    "semanticEngineIdentity": {
      "$ref": "primitives.schema.json#/$defs/contentIdentity"
    },
    "compositionProfileIdentity": {
      "$ref": "primitives.schema.json#/$defs/contentIdentity"
    },
    "generator": {
      "$ref": "program-package-profile.schema.json#/$defs/generator"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "sourceIdentity": {
      "$ref": "primitives.schema.json#/$defs/contentIdentity"
    },
    "sourceMap": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "ownerProfile",
          "semanticOwner",
          "sourceIdentity",
          "functions"
        ],
        "properties": {
          "id": {
            "$ref": "primitives.schema.json#/$defs/namespacedId"
          },
          "ownerProfile": {
            "$ref": "primitives.schema.json#/$defs/namespacedId"
          },
          "semanticOwner": {
            "$ref": "primitives.schema.json#/$defs/namespacedId"
          },
          "sourceIdentity": {
            "$ref": "primitives.schema.json#/$defs/contentIdentity"
          },
          "functions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "functions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "program-package-profile.schema.json#/$defs/function"
      }
    },
    "programUnits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "program-package-profile.schema.json#/$defs/programUnit"
      }
    },
    "entryPoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "function"
        ],
        "properties": {
          "role": {
            "$ref": "primitives.schema.json#/$defs/namespacedId"
          },
          "function": {
            "type": "string"
          }
        }
      }
    },
    "publicRequirements": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "program-package-profile.schema.json#/$defs/publicRequirement"
      }
    },
    "deviceImports": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "device-js-import-declaration.schema.json"
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "program-package-profile.schema.json#/$defs/resource"
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "program-package-profile.schema.json#/$defs/operation"
      }
    },
    "manifests": {
      "$ref": "program-package-profile.schema.json#/$defs/manifests"
    },
    "provenance": {
      "$ref": "program-package-profile.schema.json#/$defs/provenance"
    },
    "deletion": {
      "$ref": "program-package-profile.schema.json#/$defs/deletion"
    },
    "sidebands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "program-package-profile.schema.json#/$defs/sideband"
      }
    },
    "deliveries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "$ref": "program-package-profile.schema.json#/$defs/delivery"
      }
    },
    "continuation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "nodes",
        "controllerOperation"
      ],
      "properties": {
        "contract": {
          "const": "cuda-mcgs.device-continuation/0.1.0"
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "operation",
              "after"
            ],
            "properties": {
              "operation": {
                "type": "string",
                "minLength": 1
              },
              "after": {
                "type": "array",
                "maxItems": 8,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "controllerOperation": {
          "type": "string",
          "minLength": 1
        },
        "externalOperations": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "operation",
              "role"
            ],
            "properties": {
              "operation": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "enum": [
                  "external-control",
                  "read-only-observation"
                ]
              },
              "delivery": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "resource",
                  "view"
                ],
                "properties": {
                  "resource": {
                    "type": "string",
                    "minLength": 1
                  },
                  "view": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "dtype",
                      "byteOffset",
                      "elementCount"
                    ],
                    "properties": {
                      "dtype": {
                        "enum": [
                          "u32",
                          "u64",
                          "i32",
                          "f32",
                          "f64",
                          "f16",
                          "bf16"
                        ]
                      },
                      "byteOffset": {
                        "$ref": "primitives.schema.json#/$defs/decimalUint"
                      },
                      "elementCount": {
                        "$ref": "primitives.schema.json#/$defs/decimalUint"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "initializationOperations": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "operation",
              "readiness"
            ],
            "properties": {
              "operation": {
                "type": "string",
                "minLength": 1
              },
              "readiness": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "resource",
                  "view",
                  "success"
                ],
                "properties": {
                  "resource": {
                    "type": "string",
                    "minLength": 1
                  },
                  "view": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "dtype",
                      "byteOffset",
                      "elementCount"
                    ],
                    "properties": {
                      "dtype": {
                        "const": "u32"
                      },
                      "byteOffset": {
                        "$ref": "primitives.schema.json#/$defs/decimalUint"
                      },
                      "elementCount": {
                        "$ref": "primitives.schema.json#/$defs/decimalUint"
                      }
                    }
                  },
                  "success": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "wordOffset",
                      "value"
                    ],
                    "properties": {
                      "wordOffset": {
                        "$ref": "primitives.schema.json#/$defs/decimalUint"
                      },
                      "value": {
                        "$ref": "primitives.schema.json#/$defs/decimalUint"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "publicRequirementSelections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reference",
          "document"
        ],
        "properties": {
          "reference": {
            "$ref": "primitives.schema.json#/$defs/schemaReference"
          },
          "document": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "schema",
              "owner",
              "requirement",
              "lower"
            ],
            "properties": {
              "schema": {
                "const": "cuda-mcgs.public-cuda-js-requirement-selection/0.1.0"
              },
              "owner": {
                "const": "CUDA-MCGS-consumer"
              },
              "requirement": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "version",
                  "capability",
                  "value"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "version": {
                    "const": "0.1.0"
                  },
                  "capability": {
                    "type": "string",
                    "minLength": 1
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "lower": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "peer",
                  "compatibility"
                ],
                "properties": {
                  "peer": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "repository",
                      "revision",
                      "package"
                    ],
                    "properties": {
                      "repository": {
                        "const": "iteathen/CUDA-JS"
                      },
                      "revision": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{40}$"
                      },
                      "package": {
                        "const": "cuda-js@0.1.0-alpha.22"
                      }
                    }
                  },
                  "compatibility": {
                    "type": "object"
                  }
                }
              }
            }
          }
        }
      }
    },
    "deviceSourcePartition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "libraries",
        "main",
        "imports"
      ],
      "properties": {
        "contract": {
          "const": "cuda-mcgs.device-source-partition/0.1.0"
        },
        "libraries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "source",
              "sourceIdentity",
              "functions",
              "exports"
            ],
            "properties": {
              "id": {
                "$ref": "primitives.schema.json#/$defs/namespacedId"
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "sourceIdentity": {
                "$ref": "primitives.schema.json#/$defs/contentIdentity"
              },
              "functions": {
                "type": "array",
                "minItems": 1,
                "maxItems": 64,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
                }
              },
              "exports": {
                "type": "array",
                "minItems": 1,
                "maxItems": 64,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
                }
              }
            }
          }
        },
        "main": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "sourceIdentity",
            "functions"
          ],
          "properties": {
            "source": {
              "type": "string",
              "minLength": 1
            },
            "sourceIdentity": {
              "$ref": "primitives.schema.json#/$defs/contentIdentity"
            },
            "functions": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
              }
            }
          }
        },
        "imports": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "library",
              "function",
              "as"
            ],
            "properties": {
              "library": {
                "$ref": "primitives.schema.json#/$defs/namespacedId"
              },
              "function": {
                "type": "string",
                "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
              },
              "as": {
                "type": "string",
                "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "deviceImports"
        ]
      },
      "then": {
        "properties": {
          "deletion": {
            "properties": {
              "records": {
                "items": {
                  "required": [
                    "deviceImports"
                  ]
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "deletion": {
            "properties": {
              "records": {
                "items": {
                  "not": {
                    "required": [
                      "deviceImports"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
