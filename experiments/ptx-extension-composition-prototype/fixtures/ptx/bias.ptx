.version 8.0
.target sm_75
.address_size 64

.visible .func (.param .b32 result) cuda_mcgs_score_transform_v1(
    .param .b32 score,
    .param .b32 state,
    .param .b32 iteration
)
{
    .reg .b32 %r<6>;
    ld.param.u32 %r0, [score];
    ld.param.u32 %r1, [state];
    ld.param.u32 %r2, [iteration];
    xor.b32 %r3, %r1, %r2;
    and.b32 %r3, %r3, 7;
    add.u32 %r4, %r0, %r3;
    add.u32 %r4, %r4, 1;
    st.param.b32 [result], %r4;
    ret;
}
